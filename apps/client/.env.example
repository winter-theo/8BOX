# Copy to .env to override the defaults.
# Base HTTP URL of the game server; the WebSocket connects to <url>/ws. Default: http://localhost:3000 with
# `pnpm dev`; in a build, the address the page was loaded from (the server serves it: SERVE_CLIENT=1).
VITE_SERVER_URL=http://localhost:3000
# Clerk publishable key (pk_…), from the Clerk dashboard (Configure → API keys): Google sign-in.
# Without it, only the dev login exists.
VITE_CLERK_PUBLISHABLE_KEY=
