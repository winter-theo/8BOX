# Copy to .env to override the defaults (every variable is optional in development).
NODE_ENV=development
# Interface and port of the HTTP + WebSocket server.
HOST=localhost
PORT=3000
# fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
# Comma-separated browser origins allowed to open the WebSocket.
ALLOWED_ORIGINS=http://localhost:5173
# 1 accepts dev logins with a simple name (no account). Ignored when NODE_ENV=production.
# `pnpm dev` already sets it through .env.development.
DEV_AUTH=1
# Dev: world time runs this many times faster than real time, to test the night (60: a day lasts 1 minute).
# Ignored when NODE_ENV=production.
# TIME_SCALE=60
# Seed of a new world (a number or any text). Random when unset. An existing world keeps the seed stored in
# the database.
# WORLD_SEED=8box
# PostgreSQL connection URL. Defaults to the database of docker-compose.yml (`pnpm db:up`); required in production.
# DATABASE_URL=postgres://8box:8box@localhost:5432/8box
# Clerk secret key (sk_…), from the Clerk dashboard (Configure → API keys): Google sign-in. Required in
# production; without it, only dev names can sign in.
# CLERK_SECRET_KEY=sk_test_...
# Optional: Clerk PEM public key, to check session tokens without a network call.
# CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----...
# Comma-separated emails of the admins: approved at once, with the admin role.
# ADMIN_EMAILS=you@example.com
