# Copy to .env to override the defaults (every variable is optional in development).
NODE_ENV=development
# Interface and port of the HTTP + WebSocket server.
HOST=localhost
PORT=3000
# fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
# Comma-separated browser origins allowed to open the WebSocket.
ALLOWED_ORIGINS=http://localhost:5173
# 1 accepts dev logins with a simple name (no account). Ignored when NODE_ENV=production.
# `pnpm dev` already sets it through .env.development.
DEV_AUTH=1
# Seed of a new world (a number or any text). Random when unset. An existing world keeps the seed stored in
# the database.
# WORLD_SEED=8box
# PostgreSQL connection URL. Defaults to the database of docker-compose.yml (`pnpm db:up`); required in production.
# DATABASE_URL=postgres://8box:8box@localhost:5432/8box
