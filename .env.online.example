# Settings of the online test (`pnpm test:online`, docker-compose.test.yml). Copy to .env.online (never
# committed) and fill it in: docs/GUIDE.md, "Faire tester des amis".
# Clerk keys of the "development" instance (Clerk dashboard → Configure → API keys): the same as in
# apps/client/.env and apps/server/.env.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Comma-separated emails of the admins: approved at once, with the admin role (they approve the friends).
ADMIN_EMAILS=you@example.com
# Browser addresses allowed to play, comma-separated: this computer, then the tunnel address (it changes each
# time cloudflared starts), e.g. http://localhost:8080,https://words-words-words.trycloudflare.com
ALLOWED_ORIGINS=http://localhost:8080
# Seed of the world, used only when the database is new (a number or any text). Random when unset.
# WORLD_SEED=8box
