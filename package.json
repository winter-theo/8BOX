{
  "name": "8box",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:fast-time": "pnpm --parallel --filter \"./apps/*\" dev:fast-time",
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @8box/server exec drizzle-kit generate",
    "db:migrate": "pnpm --filter @8box/server exec drizzle-kit migrate",
    "test:online": "docker compose -f docker-compose.test.yml --env-file .env.online up -d --build --wait",
    "test:online:stop": "docker compose -f docker-compose.test.yml --env-file .env.online stop",
    "test:online:logs": "docker compose -f docker-compose.test.yml --env-file .env.online logs -f server",
    "tools:map": "tsx apps/server/src/tools/map.ts",
    "tools:bots": "tsx apps/server/src/tools/bots.ts",
    "tools:tiles": "tsx apps/client/scripts/tilesPreview.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
